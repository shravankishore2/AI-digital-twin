# Copy to .env to point the twin at a real backend.
# Leave both unset (or delete .env) to run fully on the built-in edge models.

# Live telemetry over WebSocket (CAN/SocketCAN → ECU-FADEC gateway → this URL)
VITE_TELEMETRY_URL=ws://localhost:8765/telemetry

# Served inference (anomaly / fault classification / RUL / health)
VITE_INFERENCE_URL=http://localhost:8765/infer
VITE_INFERENCE_HZ=2
